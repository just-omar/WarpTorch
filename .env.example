# WarpTorch Environment Configuration

# PyTorch Version: cpu or cuda (Docker only)
# Default: cpu (lightweight, ~200MB)
# Options: cpu, cuda, rocm
# Note: For local installation, see README.md for manual PyTorch installation
TORCH_VERSION=cpu

# Frontend port
FRONTEND_PORT=3005
VITE_FRONTEND_PORT=3005

# Backend port
BACKEND_PORT=8099
VITE_BACKEND_PORT=8099

# CORS allowed origins
CORS_ORIGINS=http://localhost:3005,http://frontend:3005

# Jupyter configuration
JUPYTER_PORT=8888
JUPYTER_TOKEN=warptorch
